[Unit]
Description=Telegram Bot Service
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/path/to/telegram-bot
Environment="PATH=/path/to/telegram-bot/venv/bin"
Environment="PYTHONUNBUFFERED=1"

# Main process
ExecStart=/path/to/telegram-bot/venv/bin/gunicorn \
    --workers 4 \
    --bind 0.0.0.0:5000 \
    --timeout 120 \
    --access-logfile /var/log/telegram-bot/access.log \
    --error-logfile /var/log/telegram-bot/error.log \
    --log-level info \
    api:app

# Restart policy
Restart=always
RestartSec=10

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/path/to/telegram-bot

# Resource limits
LimitNOFILE=65536
MemoryLimit=512M
CPUQuota=80%

[Install]
WantedBy=multi-user.target
